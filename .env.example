# ==============================================================================
# PRALAYA: Environment Variables Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Operational Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Gateway Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-Side Artificial Intelligence Secrets (NEVER EXPOSE IN FRONTEND)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Spatial Database & Caching (Server-Side Only)
DATABASE_URL=postgresql+asyncpg://pralaya_user:pralaya_pass@localhost:5432/pralaya
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication Secret (Server-Side Only)
SECRET_KEY=generate_a_secure_random_64_character_secret_here
